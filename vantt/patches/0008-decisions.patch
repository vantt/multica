+// Code generated by sqlc. DO NOT EDIT.
+// versions:
+//   sqlc v1.31.1
+// source: issue_decision.sql
+
+package db
+
+import (
+	"context"
+
+	"github.com/jackc/pgx/v5/pgtype"
+)
+
+const answerIssueDecision = `-- name: AnswerIssueDecision :one
+UPDATE issue_decision SET
+    status = 'answered',
+    answer_option_id = $3,
+    answer_note = $4,
+    answered_by = $5,
+    answered_at = now()
+WHERE id = $1 AND workspace_id = $2 AND status = 'open'
+RETURNING id, issue_id, workspace_id, question, options, status, due_date, asked_by_type, asked_by_id, answer_option_id, answer_note, answered_by, answered_at, created_at
+`
+
+type AnswerIssueDecisionParams struct {
+	ID             pgtype.UUID `json:"id"`
+	WorkspaceID    pgtype.UUID `json:"workspace_id"`
+	AnswerOptionID pgtype.Text `json:"answer_option_id"`
+	AnswerNote     string      `json:"answer_note"`
+	AnsweredBy     pgtype.UUID `json:"answered_by"`
+}
+
+func (q *Queries) AnswerIssueDecision(ctx context.Context, arg AnswerIssueDecisionParams) (IssueDecision, error) {
+	row := q.db.QueryRow(ctx, answerIssueDecision,
+		arg.ID,
+		arg.WorkspaceID,
+		arg.AnswerOptionID,
+		arg.AnswerNote,
+		arg.AnsweredBy,
+	)
+	var i IssueDecision
+	err := row.Scan(
+		&i.ID,
+		&i.IssueID,
+		&i.WorkspaceID,
+		&i.Question,
+		&i.Options,
+		&i.Status,
+		&i.DueDate,
+		&i.AskedByType,
+		&i.AskedByID,
+		&i.AnswerOptionID,
