@@ -0,0 +1,45 @@
+import { cleanup, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { renderWithI18n } from "../../test/i18n";
+import { ChildStatusBar, DaysInStatus } from "./child-panel-extras";
+
+const since = (days: number) => new Date(Date.now() - days * 86_400_000 - 60_000).toISOString();
+let entries: Record<string, { status: string; since: string }> = {};
+
+vi.mock("@multica/core/hooks", () => ({ useWorkspaceId: () => "ws-1" }));
+vi.mock("@multica/core/issue-statuses/hooks", () => ({
+  useIssueStatuses: () => ({
+    categoryOf: (s: string) => (s === "done" ? "done" : s === "todo" ? "unstarted" : "started"),
+    colorOf: () => "#888888",
+  }),
+}));
+vi.mock("../utils/status-label", () => ({ useStatusLabel: () => (s: string) => s }));
+vi.mock("@tanstack/react-query", () => ({ useQuery: () => ({ data: entries }) }));
+
+afterEach(cleanup);
+
+describe("ChildStatusBar", () => {
+  it("summarises children by status, done first", () => {
+    renderWithI18n(<ChildStatusBar issues={[{ status: "todo" }, { status: "done" }, { status: "done" }, { status: "in_review" }]} />);
+    expect(screen.getByTitle("2 done, 1 in_review, 1 todo")).toBeTruthy();
+  });
+  it("draws nothing without children", () => {
+    const { container } = renderWithI18n(<ChildStatusBar issues={[]} />);
+    expect(container.textContent).toBe("");
+  });
+});
+
+describe("DaysInStatus", () => {
+  it("shows whole days in the current status", () => {
+    entries = { a: { status: "in_review", since: since(6) } };
+    renderWithI18n(<DaysInStatus issue={{ id: "a", status: "in_review", project_id: "p" }} />);
+    expect(screen.getByText("6d")).toBeTruthy();
+    expect(screen.getByTitle("6 days in in_review")).toBeTruthy();
+  });
+  it("hides under a day and after the issue moved", () => {
+    entries = { a: { status: "todo", since: since(0) }, b: { status: "todo", since: since(3) } };
+    renderWithI18n(<DaysInStatus issue={{ id: "a", status: "todo", project_id: "p" }} />);
+    renderWithI18n(<DaysInStatus issue={{ id: "b", status: "in_review", project_id: "p" }} />);
+    expect(screen.queryByText(/\dd$/)).toBeNull();
+  });
+});
diff --git a/packages/views/issues/components/child-panel-extras.tsx b/packages/views/issues/components/child-panel-extras.tsx
new file mode 100644
index 000000000..89468f033
--- /dev/null
+++ b/packages/views/issues/components/child-panel-extras.tsx
@@ -0,0 +1,74 @@
+"use client";
+
+import { useQuery } from "@tanstack/react-query";
+import { useWorkspaceId } from "@multica/core/hooks";
+import { daysInColumn, statusSinceOptions } from "@multica/core/board-gates";
+import { useIssueStatuses } from "@multica/core/issue-statuses/hooks";
+import type { Issue } from "@multica/core/types";
+import { cn } from "@multica/ui/lib/utils";
+import { useT } from "../../i18n";
+import { useStatusLabel } from "../utils/status-label";
+
+const CATEGORY_ORDER = ["done", "started", "unstarted", "backlog", "closed", "cancelled"];
+
+/**
+ * Child issues by status (vantt parent-child, design D9): one bar segment per
+ * status, coloured like the status, done first. Reference: Jira's "Child issues"
+ * progress bar.
+ */
+export function ChildStatusBar({ issues }: { issues: readonly Pick<Issue, "status">[] }) {
+  const { t } = useT("issues");
+  const wsId = useWorkspaceId();
+  const catalog = useIssueStatuses(wsId);
+  const labelOf = useStatusLabel(wsId);
+  if (issues.length === 0) return null;
+  const counts = new Map<string, number>();
+  for (const c of issues) counts.set(c.status, (counts.get(c.status) ?? 0) + 1);
+  const rank = (s: string) => {
+    const i = CATEGORY_ORDER.indexOf(catalog.categoryOf(s));
+    return i < 0 ? CATEGORY_ORDER.length : i;
+  };
+  const parts = [...counts].sort((a, b) => rank(a[0]) - rank(b[0]) || b[1] - a[1]);
+  const summary = parts.map(([s, n]) => `${n} ${labelOf(s)}`).join(", ");
+  return (
+    <span
+      role="img"
+      aria-label={t(($) => $.child_panel.status_bar, { summary })}
+      title={summary}
+      className="flex h-1.5 w-24 shrink-0 overflow-hidden rounded-full bg-muted sm:w-32"
+    >
+      {parts.map(([status, n]) => (
+        <span
+          key={status}
+          style={{ width: `${(n / issues.length) * 100}%`, backgroundColor: catalog.colorOf(status) ?? undefined }}
+          className="h-full"
+        />
+      ))}
+    </span>
+  );
+}
+
+/**
+ * Days a child has sat in its status (vantt parent-child, design D9); shown from
+ * one day on, red from five. Done and cancelled children show nothing.
+ */
+export function DaysInStatus({ issue, className }: { issue: Pick<Issue, "id" | "status" | "project_id">; className?: string }) {
+  const { t } = useT("issues");
+  const wsId = useWorkspaceId();
+  const labelOf = useStatusLabel(wsId);
+  const { data } = useQuery(statusSinceOptions(wsId, issue.project_id ?? null));
+  const days = daysInColumn(data?.[issue.id], issue.status);
+  if (days === null || days < 1) return null;
+  return (
+    <span
+      title={t(($) => $.child_panel.days_title, { count: days, status: labelOf(issue.status) })}
+      className={cn(
+        "shrink-0 text-caption tabular-nums",
+        days >= 5 ? "font-medium text-destructive" : "text-muted-foreground",
+        className,
+      )}
+    >
+      {t(($) => $.child_panel.days, { count: days })}
+    </span>
+  );
+}
