+	bad := withURLParam(goalRequest("PUT", "/api/projects/"+f.projectID+"/workflow-rules", map[string]any{
+		"rules": []map[string]any{{"property_id": f.propertyID, "option_id": "not-an-option", "workflow_id": f.contentWF}},
