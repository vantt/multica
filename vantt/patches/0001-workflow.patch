+package handler
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+
+	"testing"
+)
+
+// Domain follows Type: a select property described "Derived from <Type>" takes the
+// option named like the part of the Type option before " · ".
+func TestDerivedPropertyFollowsSource(t *testing.T) {
+	typ := createTestProperty(t, map[string]any{"name": "VType", "type": "select", "config": map[string]any{"options": []map[string]any{
+		{"name": "Tech · Feature", "color": "#2563eb"}, {"name": "Marketing · Post", "color": "#db2777"}, {"name": "Other", "color": "#71717a"},
+	}}})
+	dom := createTestProperty(t, map[string]any{"name": "VDomain", "type": "select", "description": "Derived from VType (the part before ·).", "config": map[string]any{"options": []map[string]any{
+		{"name": "Tech", "color": "#2563eb"}, {"name": "Marketing", "color": "#db2777"},
+	}}})
+	opt := func(p PropertyResponse, name string) string {
+		for _, o := range p.Config.Options {
+			if o.Name == name {
+				return o.ID
+			}
+		}
+		t.Fatalf("no option %s", name)
+		return ""
+	}
+	domainOf := func(issueID string) string {
+		var raw []byte
+		if err := testPool.QueryRow(context.Background(), `SELECT properties FROM issue WHERE id = $1`, issueID).Scan(&raw); err != nil {
+			t.Fatal(err)
+		}
+		bag := map[string]string{}
+		_ = json.Unmarshal(raw, &bag)
+		return bag[dom.ID]
+	}
+	var first IssueResponse
+	w0 := httptestRecorderCall(t, newRequest("POST", "/api/issues?workspace_id="+testWorkspaceID, map[string]any{"title": "derive me", "status": "todo"}))
+	if w0.Code != http.StatusCreated {
+		t.Fatalf("create: %d %s", w0.Code, w0.Body.String())
+	}
+	_ = json.Unmarshal(w0.Body.Bytes(), &first)
+	issueID := first.ID
+	t.Cleanup(func() { testPool.Exec(context.Background(), `DELETE FROM issue WHERE id = $1`, issueID) })
+	if w := setIssuePropertyRaw(t, issueID, typ.ID, opt(typ, "Tech · Feature")); w.Code != http.StatusOK {
+		t.Fatalf("set type: %d %s", w.Code, w.Body.String())
+	}
+	if got := domainOf(issueID); got != opt(dom, "Tech") {
+		t.Fatalf("domain = %q, want Tech", got)
+	}
+	setIssuePropertyRaw(t, issueID, typ.ID, opt(typ, "Marketing · Post"))
+	if got := domainOf(issueID); got != opt(dom, "Marketing") {
+		t.Fatalf("domain after change = %q, want Marketing", got)
+	}
+	// No matching option: the derived value is left alone.
+	setIssuePropertyRaw(t, issueID, typ.ID, opt(typ, "Other"))
+	if got := domainOf(issueID); got != opt(dom, "Marketing") {
+		t.Fatalf("domain changed without a matching option: %q", got)
+	}
+
+	// On create, too.
+	var created IssueResponse
+	w := httptestRecorderCall(t, newRequest("POST", "/api/issues?workspace_id="+testWorkspaceID, map[string]any{
+		"title": "derive on create", "properties": map[string]any{typ.ID: opt(typ, "Tech · Feature")},
+	}))
+	if w.Code != http.StatusCreated {
+		t.Fatalf("create: %d %s", w.Code, w.Body.String())
+	}
+	_ = json.Unmarshal(w.Body.Bytes(), &created)
+	t.Cleanup(func() { testPool.Exec(context.Background(), `DELETE FROM issue WHERE id = $1`, created.ID) })
+	if got := domainOf(created.ID); got != opt(dom, "Tech") {
+		t.Fatalf("domain on create = %q, want Tech", got)
+	}
+}
+
+func httptestRecorderCall(t *testing.T, req *http.Request) *httptest.ResponseRecorder {
+	t.Helper()
+	w := httptest.NewRecorder()
+	testHandler.CreateIssue(w, req)
+	return w
+}
diff --git a/server/internal/handler/vantt_owner_gates_test.go b/server/internal/handler/vantt_owner_gates_test.go
new file mode 100644
index 000000000..3b0de02ff
--- /dev/null
+++ b/server/internal/handler/vantt_owner_gates_test.go
@@ -0,0 +1,119 @@
+package handler
+
+import (
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/multica-ai/multica/server/internal/testutil"
+)
+
+// vantt owner-gates: a step whose handler is a person is a gate. An agent may
+// not move the issue out of it, by status or by project; a member may.
+
+// goalRequest is a request in the test workspace; the fork's handler tests
+// (workflow rules, goals) share it.
+func goalRequest(method, path string, body any) *http.Request {
+	return newRequest(method, path+"?workspace_id="+testWorkspaceID, body)
+}
+
+func ownerGateProject(t *testing.T, agentID string) string {
+	t.Helper()
+	projectID := deliveryProject(t, "Owner gate project "+workflowTestSuffix(), agentID)
+	setColumnHandoff(t, projectID, "in_review", map[string]any{
+		"handler": map[string]any{"type": "member", "id": testUserID}, "instructions": "Approve the PR.",
+	}).Want(http.StatusOK)
+	return projectID
+}
+
+func runningTask(t *testing.T, agentID, issueID, step string) string {
+	t.Helper()
+	var runtimeID string
+	dbfx.QueryRow(t, `SELECT runtime_id::text FROM agent WHERE id = $1`, agentID).Scan(&runtimeID)
+	return dbfx.Task(t, agentID, testutil.Cols{
+		"issue_id": issueID, "runtime_id": runtimeID, "status": "running", "started_at": time.Now(), "workflow_step": step,
+	})
+}
+
+func TestAgentCannotLeaveOwnerGate(t *testing.T) {
+	seedTestCatalog(t)
+	agentID := seededReadyAgentID(t)
+	projectID := ownerGateProject(t, agentID)
+	issueID := dbfx.Issue(t, "gated", testutil.Cols{"project_id": projectID, "status": "in_review"})
+	// A run of the agent on this issue, even one started for this very step.
+	taskID := runningTask(t, agentID, issueID, "in_review")
+
+	body := agentUpdateIssue(t, issueID, agentID, taskID, map[string]any{"status": "done"}).Want(http.StatusForbidden).Map()
+	if body["code"] != "owner_gate" || body["status"] != "in_review" {
+		t.Fatalf("refusal = %v", body)
+	}
+	if status, _, _ := issueStatusAndAssignee(t, issueID); status != "in_review" {
+		t.Fatalf("status = %q, the refused change must not apply", status)
+	}
+
+	// Moving it to another project is leaving the gate too.
+	other := createWorkflowTestProject(t, "Owner gate other "+workflowTestSuffix())
+	agentUpdateIssue(t, issueID, agentID, taskID, map[string]any{"project_id": other}).Want(http.StatusForbidden)
+
+	// Other fields still change.
+	agentUpdateIssue(t, issueID, agentID, taskID, map[string]any{"title": "gated, noted"}).Want(http.StatusOK)
+
+	// A member moves it on.
+	updateIssueForTest(t, issueID, map[string]any{"status": "done"}).Want(http.StatusOK)
+	if status, _, _ := issueStatusAndAssignee(t, issueID); status != "done" {
+		t.Fatalf("status after the member's move = %q, want done", status)
+	}
+}
+
+// An agent with no run on the issue (a board sync on another issue, say) is
+// refused the same way.
+func TestAgentFromAnotherIssueCannotLeaveOwnerGate(t *testing.T) {
+	seedTestCatalog(t)
+	agentID := seededReadyAgentID(t)
+	projectID := ownerGateProject(t, agentID)
+	gated := dbfx.Issue(t, "gated elsewhere", testutil.Cols{"project_id": projectID, "status": "in_review"})
+	elsewhere := dbfx.Issue(t, "sync run", testutil.Cols{"project_id": projectID, "status": "todo"})
+	taskID := runningTask(t, agentID, elsewhere, "todo")
+
+	agentUpdateIssue(t, gated, agentID, taskID, map[string]any{"status": "todo"}).Want(http.StatusForbidden)
+}
+
+// Steps an agent handles are not gates: agents keep moving their own work.
+func TestAgentStepIsNotAGate(t *testing.T) {
+	seedTestCatalog(t)
+	agentID := seededReadyAgentID(t)
+	projectID := ownerGateProject(t, agentID)
+	issueID := dbfx.Issue(t, "agent step", testutil.Cols{"project_id": projectID, "status": "todo"})
+	updateIssueForTest(t, issueID, map[string]any{"status": "in_progress"}).Want(http.StatusOK)
+	var taskID string
+	dbfx.QueryRow(t, `SELECT id::text FROM agent_task_queue WHERE issue_id = $1 AND agent_id = $2`, issueID, agentID).Scan(&taskID)
+	dbfx.Exec(t, `UPDATE agent_task_queue SET status = 'running', started_at = now() WHERE id = $1`, taskID)
+
+	// Into the gate is fine: that is how work reaches the owner.
+	agentUpdateIssue(t, issueID, agentID, taskID, map[string]any{"status": "in_review"}).Want(http.StatusOK)
+}
+
+// The batch endpoint skips a gated issue for an agent and applies the rest.
+func TestBatchSkipsOwnerGateForAgent(t *testing.T) {
+	seedTestCatalog(t)
+	agentID := seededReadyAgentID(t)
+	projectID := ownerGateProject(t, agentID)
+	gated := dbfx.Issue(t, "batch gated", testutil.Cols{"project_id": projectID, "status": "in_review"})
+	free := dbfx.Issue(t, "batch free", testutil.Cols{"project_id": projectID, "status": "backlog"})
+	taskID := runningTask(t, agentID, free, "backlog")
+
+	req := newRequest("POST", "/api/issues/batch-update", map[string]any{
+		"issue_ids": []string{gated, free}, "updates": map[string]any{"status": "todo"},
+	})
+	req.Header.Set("X-Actor-Source", "task_token")
+	req.Header.Set("X-Agent-ID", agentID)
+	req.Header.Set("X-Task-ID", taskID)
+	testutil.Call(t, testHandler.BatchUpdateIssues, req).Want(http.StatusOK)
+
+	if status, _, _ := issueStatusAndAssignee(t, gated); status != "in_review" {
+		t.Fatalf("gated status = %q, the batch must skip it", status)
+	}
+	if status, _, _ := issueStatusAndAssignee(t, free); status != "todo" {
+		t.Fatalf("free status = %q, want todo", status)
+	}
+}
diff --git a/server/internal/handler/vantt_send_back_limit.go b/server/internal/handler/vantt_send_back_limit.go
new file mode 100644
index 000000000..db02ad2f2
--- /dev/null
+++ b/server/internal/handler/vantt_send_back_limit.go
@@ -0,0 +1,192 @@
+package handler
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgtype"
+	"github.com/multica-ai/multica/server/internal/issueworkflow"
+	db "github.com/multica-ai/multica/server/pkg/db/generated"
+)
+
+// vantt send-back-limit: a workflow may cap how many times agents send an
+// issue back along a step's back edge (review → build, QA → build) with no
+// person moving the issue in between. Past the cap the server refuses the
+// agent's move with 409 {code: send_back_limit}; a person's move is never
+// refused and starts a fresh count. No row in vantt_workflow_limit = no cap.
+
+// SendBackLimitError refuses one more agent send-back.
+type SendBackLimitError struct {
+	Status, Back string
+	Count, Limit int
+}
+
+func (e *SendBackLimitError) Error() string {
+	return fmt.Sprintf("this issue was already sent back %d times by agents with no person in between (limit %d); "+
+		"do not send it back to %q again: leave it in %q, comment what is still in dispute and @mention a person",
+		e.Count, e.Limit, e.Back, e.Status)
+}
+
+func writeSendBackLimitError(w http.ResponseWriter, err error) bool {
+	var limit *SendBackLimitError
+	if !errors.As(err, &limit) {
+		return false
+	}
+	writeJSON(w, http.StatusConflict, map[string]any{
+		"error":  limit.Error(),
+		"code":   "send_back_limit",
+		"status": limit.Status,
+		"back":   limit.Back,
+		"count":  limit.Count,
+		"limit":  limit.Limit,
+	})
+	return true
+}
+
+// workflowSendBackLimit returns the workflow's cap, 0 when it has none.
+func (h *Handler) workflowSendBackLimit(ctx context.Context, workflowID pgtype.UUID) (int, error) {
+	var limit int
+	err := h.DB.QueryRow(ctx, `SELECT max_send_backs FROM vantt_workflow_limit WHERE workflow_id = $1`, workflowID).Scan(&limit)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return 0, nil
+	}
+	return limit, err
+}
+
+// refuseSendBackOverLimit runs for an agent's status change from prev.Status
+// to `to` inside workflow def.
+func (h *Handler) refuseSendBackOverLimit(ctx context.Context, def *issueworkflow.Definition, prev db.Issue, to string) error {
+	if def == nil || !def.ID.Valid {
+		return nil
+	}
+	step, ok := def.Step(prev.Status)
+	if !ok || step.BackStatusKey == "" || step.BackStatusKey != to {
+		return nil
+	}
+	limit, err := h.workflowSendBackLimit(ctx, def.ID)
+	if err != nil || limit == 0 {
+		return err
+	}
+	// Status moves since the last one a person made, oldest first. Each agent
+	// move along a back edge of the current workflow counts.
+	rows, err := h.DB.Query(ctx, `
+		SELECT COALESCE(details->>'from', ''), COALESCE(details->>'to', '')
+		FROM activity_log
+		WHERE issue_id = $1 AND action = 'status_changed' AND actor_type = 'agent'
+		  AND created_at > COALESCE((
+		      SELECT MAX(created_at) FROM activity_log
+		      WHERE issue_id = $1 AND action = 'status_changed' AND actor_type = 'member'
+		  ), '-infinity'::timestamptz)`, prev.ID)
+	if err != nil {
+		return err
+	}
+	defer rows.Close()
+	count := 0
+	for rows.Next() {
+		var from, toKey string
+		if err := rows.Scan(&from, &toKey); err != nil {
+			return err
+		}
+		if s, ok := def.Step(from); ok && s.BackStatusKey != "" && s.BackStatusKey == toKey {
+			count++
+		}
+	}
+	if err := rows.Err(); err != nil {
+		return err
+	}
+	if count >= limit {
+		return &SendBackLimitError{Status: prev.Status, Back: to, Count: count, Limit: limit}
+	}
+	return nil
+}
+
+type workflowLimitsBody struct {
+	MaxSendBacks *int `json:"max_send_backs"`
+}
+
+// GetIssueWorkflowLimits answers {max_send_backs: n | null}. Any member reads.
+func (h *Handler) GetIssueWorkflowLimits(w http.ResponseWriter, r *http.Request) {
+	workspaceID := h.resolveWorkspaceID(r)
+	wsUUID, ok := parseUUIDOrBadRequest(w, workspaceID, "workspace id")
+	if !ok {
+		return
+	}
+	if _, ok := h.requireWorkspaceMember(w, r, workspaceID, "workspace not found"); !ok {
+		return
+	}
+	idUUID, ok := parseUUIDOrBadRequest(w, chi.URLParam(r, "id"), "workflow id")
+	if !ok {
+		return
+	}
+	if _, err := h.Queries.GetIssueWorkflow(r.Context(), db.GetIssueWorkflowParams{ID: idUUID, WorkspaceID: wsUUID}); err != nil {
+		writeError(w, http.StatusNotFound, "workflow not found")
+		return
+	}
+	limit, err := h.workflowSendBackLimit(r.Context(), idUUID)
+	if err != nil {
+		writeError(w, http.StatusInternalServerError, "failed to read workflow limits")
+		return
+	}
+	body := workflowLimitsBody{}
+	if limit > 0 {
+		body.MaxSendBacks = &limit
+	}
+	writeJSON(w, http.StatusOK, body)
+}
+
+// SetIssueWorkflowLimits sets or clears (null or 0) the cap. Same people who
+// may edit the workflow.
+func (h *Handler) SetIssueWorkflowLimits(w http.ResponseWriter, r *http.Request) {
+	workspaceID := h.resolveWorkspaceID(r)
+	wsUUID, ok := parseUUIDOrBadRequest(w, workspaceID, "workspace id")
+	if !ok {
+		return
+	}
+	member, ok := h.requireWorkspaceMember(w, r, workspaceID, "workspace not found")
+	if !ok {
+		return
+	}
+	idUUID, ok := parseUUIDOrBadRequest(w, chi.URLParam(r, "id"), "workflow id")
+	if !ok {
+		return
+	}
+	var body workflowLimitsBody
+	if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+		writeError(w, http.StatusBadRequest, "invalid request body")
+		return
+	}
+	if body.MaxSendBacks != nil && *body.MaxSendBacks < 0 {
+		writeError(w, http.StatusBadRequest, "max_send_backs must be 0 (no limit) or more")
+		return
+	}
+	current, err := h.Queries.GetIssueWorkflow(r.Context(), db.GetIssueWorkflowParams{ID: idUUID, WorkspaceID: wsUUID})
+	if err != nil {
+		writeError(w, http.StatusNotFound, "workflow not found")
+		return
+	}
+	if !canEditIssueWorkflow(member, current) {
+		writeError(w, http.StatusForbidden, "only the workflow owner and workspace admins can change this workflow")
+		return
+	}
+	if body.MaxSendBacks == nil || *body.MaxSendBacks == 0 {
+		_, err = h.DB.Exec(r.Context(), `DELETE FROM vantt_workflow_limit WHERE workflow_id = $1`, idUUID)
+	} else {
+		_, err = h.DB.Exec(r.Context(), `
+			INSERT INTO vantt_workflow_limit (workflow_id, max_send_backs) VALUES ($1, $2)
+			ON CONFLICT (workflow_id) DO UPDATE SET max_send_backs = EXCLUDED.max_send_backs, updated_at = now()`,
+			idUUID, *body.MaxSendBacks)
+	}
+	if err != nil {
+		writeError(w, http.StatusInternalServerError, "failed to save workflow limits")
+		return
+	}
+	if body.MaxSendBacks != nil && *body.MaxSendBacks == 0 {
+		body.MaxSendBacks = nil
+	}
+	writeJSON(w, http.StatusOK, body)
+}
diff --git a/server/internal/handler/vantt_send_back_limit_test.go b/server/internal/handler/vantt_send_back_limit_test.go
new file mode 100644
index 000000000..efee1953e
--- /dev/null
+++ b/server/internal/handler/vantt_send_back_limit_test.go
@@ -0,0 +1,109 @@
+package handler
+
+import (
+	"context"
+	"net/http"
+	"testing"
+
+	"github.com/multica-ai/multica/server/internal/testutil"
+)
+
+// vantt send-back-limit: agents may send an issue back along a back edge at
+// most max_send_backs times with no person moving it in between.
+
+func sendBackProject(t *testing.T, agentID string) (projectID, workflowID string) {
+	t.Helper()
+	projectID = deliveryProject(t, "Send-back project "+workflowTestSuffix(), agentID)
+	setColumnHandoff(t, projectID, "in_review", map[string]any{
+		"handler": map[string]any{"type": "agent", "id": agentID}, "instructions": "Review the PR.",
+		"back_status_key": "in_progress",
+	}).Want(http.StatusOK)
+	workflowID = projectWorkflowID(t, projectID)
+	t.Cleanup(func() {
+		testPool.Exec(context.Background(), `DELETE FROM vantt_workflow_limit WHERE workflow_id = $1`, workflowID)
+	})
+	return projectID, workflowID
+}
+
+func setSendBackLimit(t *testing.T, workflowID string, body map[string]any) *testutil.Response {
+	t.Helper()
+	req := withURLParam(workflowRequest("PUT", "/api/issue-workflows/"+workflowID+"/limits", body), "id", workflowID)
+	return testutil.Call(t, testHandler.SetIssueWorkflowLimits, req)
+}
+
+// recordStatusMove writes the timeline row the activity listener writes.
+func recordStatusMove(t *testing.T, issueID, actorType, actorID, from, to string) {
+	t.Helper()
+	if _, err := testPool.Exec(context.Background(), `
+		INSERT INTO activity_log (workspace_id, issue_id, actor_type, actor_id, action, details)
+		VALUES ($1, $2, $3, $4, 'status_changed', jsonb_build_object('from', $5::text, 'to', $6::text))`,
+		testWorkspaceID, issueID, actorType, actorID, from, to); err != nil {
+		t.Fatalf("record status move: %v", err)
+	}
+}
+
+func TestAgentSendBackLimit(t *testing.T) {
+	seedTestCatalog(t)
+	agentID := seededReadyAgentID(t)
+	projectID, workflowID := sendBackProject(t, agentID)
+	setSendBackLimit(t, workflowID, map[string]any{"max_send_backs": 2}).Want(http.StatusOK)
+
+	issueID := dbfx.Issue(t, "disputed", testutil.Cols{"project_id": projectID, "status": "in_review"})
+	taskID := runningTask(t, agentID, issueID, "in_review")
+	// Two send-backs already, plus forward moves that do not count.
+	for i := 0; i < 2; i++ {
+		recordStatusMove(t, issueID, "agent", agentID, "in_review", "in_progress")
+		recordStatusMove(t, issueID, "agent", agentID, "in_progress", "in_review")
+	}
+
+	body := agentUpdateIssue(t, issueID, agentID, taskID, map[string]any{"status": "in_progress"}).Want(http.StatusConflict).Map()
+	if body["code"] != "send_back_limit" || body["status"] != "in_review" || body["back"] != "in_progress" {
+		t.Fatalf("refusal = %v", body)
+	}
+	if status, _, _ := issueStatusAndAssignee(t, issueID); status != "in_review" {
+		t.Fatalf("status = %q, the refused move must not apply", status)
+	}
+	// Other moves out of the step are not send-backs.
+	agentUpdateIssue(t, issueID, agentID, taskID, map[string]any{"title": "disputed, noted"}).Want(http.StatusOK)
+
+	// A person's move starts a fresh count.
+	recordStatusMove(t, issueID, "member", testUserID, "in_progress", "in_review")
+	agentUpdateIssue(t, issueID, agentID, taskID, map[string]any{"status": "in_progress"}).Want(http.StatusOK)
+}
+
+func TestMemberSendBackHasNoLimit(t *testing.T) {
+	seedTestCatalog(t)
+	agentID := seededReadyAgentID(t)
+	projectID, workflowID := sendBackProject(t, agentID)
+	setSendBackLimit(t, workflowID, map[string]any{"max_send_backs": 1}).Want(http.StatusOK)
+
+	issueID := dbfx.Issue(t, "member sends back", testutil.Cols{"project_id": projectID, "status": "in_review"})
+	recordStatusMove(t, issueID, "agent", agentID, "in_review", "in_progress")
+	recordStatusMove(t, issueID, "agent", agentID, "in_progress", "in_review")
+	updateIssueForTest(t, issueID, map[string]any{"status": "in_progress"}).Want(http.StatusOK)
+}
+
+func TestSendBackWithoutLimitIsUpstream(t *testing.T) {
+	seedTestCatalog(t)
+	agentID := seededReadyAgentID(t)
+	projectID, workflowID := sendBackProject(t, agentID)
+
+	issueID := dbfx.Issue(t, "no limit", testutil.Cols{"project_id": projectID, "status": "in_review"})
+	taskID := runningTask(t, agentID, issueID, "in_review")
+	for i := 0; i < 5; i++ {
+		recordStatusMove(t, issueID, "agent", agentID, "in_review", "in_progress")
+	}
+	agentUpdateIssue(t, issueID, agentID, taskID, map[string]any{"status": "in_progress"}).Want(http.StatusOK)
+
+	// Clearing a limit (0) answers null.
+	setSendBackLimit(t, workflowID, map[string]any{"max_send_backs": 3}).Want(http.StatusOK)
+	got := setSendBackLimit(t, workflowID, map[string]any{"max_send_backs": 0}).Want(http.StatusOK).Map()
+	if got["max_send_backs"] != nil {
+		t.Fatalf("cleared limit = %v, want null", got["max_send_backs"])
+	}
+	read := testutil.Call(t, testHandler.GetIssueWorkflowLimits,
+		withURLParam(workflowRequest("GET", "/api/issue-workflows/"+workflowID+"/limits", nil), "id", workflowID)).Want(http.StatusOK).Map()
+	if read["max_send_backs"] != nil {
+		t.Fatalf("read limit = %v, want null", read["max_send_backs"])
+	}
+}
diff --git a/server/internal/handler/vantt_workflow_rules.go b/server/internal/handler/vantt_workflow_rules.go
new file mode 100644
index 000000000..82c78aa3a
--- /dev/null
+++ b/server/internal/handler/vantt_workflow_rules.go
@@ -0,0 +1,219 @@
+package handler
+
+// vantt workflow-by-type (patch workflow-by-type, F3): in a project, issues whose
+// select property (e.g. Type) has a given option follow another workflow.
+// Reference: Jira workflow schemes (issue type → workflow).
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"log/slog"
+	"net/http"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/jackc/pgx/v5/pgtype"
+	"github.com/multica-ai/multica/server/internal/issuestatus"
+	"github.com/multica-ai/multica/server/internal/issueworkflow"
+	"github.com/multica-ai/multica/server/internal/util"
+	"github.com/multica-ai/multica/server/pkg/protocol"
+	db "github.com/multica-ai/multica/server/pkg/db/generated"
+)
+
+type WorkflowRuleJSON struct {
+	PropertyID string `json:"property_id"`
+	OptionID   string `json:"option_id"`
+	WorkflowID string `json:"workflow_id"`
+}
+
+func (h *Handler) loadProjectForRules(w http.ResponseWriter, r *http.Request) (db.Project, bool) {
+	wsID := h.resolveWorkspaceID(r)
+	if _, ok := h.requireWorkspaceMember(w, r, wsID, "workspace not found"); !ok {
+		return db.Project{}, false
+	}
+	wsUUID, ok := parseUUIDOrBadRequest(w, wsID, "workspace id")
+	if !ok {
+		return db.Project{}, false
+	}
+	id, ok := parseUUIDOrBadRequest(w, chi.URLParam(r, "id"), "project id")
+	if !ok {
+		return db.Project{}, false
+	}
+	project, err := h.Queries.GetProjectInWorkspace(r.Context(), db.GetProjectInWorkspaceParams{ID: id, WorkspaceID: wsUUID})
+	if err != nil {
+		writeError(w, http.StatusNotFound, "project not found")
+		return db.Project{}, false
+	}
+	return project, true
+}
+
+func rulesToJSON(rules []db.ProjectWorkflowRule) []WorkflowRuleJSON {
+	out := make([]WorkflowRuleJSON, 0, len(rules))
+	for _, rule := range rules {
+		out = append(out, WorkflowRuleJSON{PropertyID: uuidToString(rule.PropertyID), OptionID: rule.OptionID, WorkflowID: uuidToString(rule.WorkflowID)})
+	}
+	return out
+}
+
+func (h *Handler) ListProjectWorkflowRules(w http.ResponseWriter, r *http.Request) {
+	project, ok := h.loadProjectForRules(w, r)
+	if !ok {
+		return
+	}
+	rules, err := h.Queries.ListProjectWorkflowRules(r.Context(), db.ListProjectWorkflowRulesParams{ProjectID: project.ID, WorkspaceID: project.WorkspaceID})
+	if err != nil {
+		writeError(w, http.StatusInternalServerError, "failed to list rules")
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]any{"rules": rulesToJSON(rules)})
+}
+
+// SetProjectWorkflowRules replaces a project's rules. Owner/admin only. Every
+// rule names a select property of the workspace, one of its options and a
+// workflow of the workspace. Existing issues keep their status; they follow
+// the new workflow from their next move.
+func (h *Handler) SetProjectWorkflowRules(w http.ResponseWriter, r *http.Request) {
+	project, ok := h.loadProjectForRules(w, r)
+	if !ok {
+		return
+	}
+	if _, ok := h.requireWorkspaceRole(w, r, uuidToString(project.WorkspaceID), "workspace not found", "owner", "admin"); !ok {
+		return
+	}
+	var req struct {
+		Rules []WorkflowRuleJSON `json:"rules"`
+	}
+	body, err := io.ReadAll(r.Body)
+	if err != nil || json.Unmarshal(body, &req) != nil {
+		writeError(w, http.StatusBadRequest, "invalid request body")
+		return
+	}
+	ctx := r.Context()
+	type parsed struct {
+		property, workflow pgtype.UUID
+		option             string
+	}
+	var rules []parsed
+	seen := map[string]bool{}
+	for _, rule := range req.Rules {
+		propID, err1 := util.ParseUUID(rule.PropertyID)
+		wfID, err2 := util.ParseUUID(rule.WorkflowID)
+		if err1 != nil || err2 != nil || rule.OptionID == "" {
+			writeError(w, http.StatusBadRequest, "each rule needs property_id, option_id and workflow_id")
+			return
+		}
+		prop, err := h.Queries.GetIssueProperty(ctx, db.GetIssuePropertyParams{ID: propID, WorkspaceID: project.WorkspaceID})
+		if err != nil || prop.Type != "select" {
+			writeError(w, http.StatusBadRequest, "property must be a select property of this workspace")
+			return
+		}
+		cfg := parsePropertyConfig(prop.Config)
+		known := false
+		for _, o := range cfg.Options {
+			known = known || o.ID == rule.OptionID
+		}
+		if !known {
+			writeError(w, http.StatusBadRequest, "option is not one of the property's options")
+			return
+		}
+		if _, err := h.Queries.GetIssueWorkflow(ctx, db.GetIssueWorkflowParams{ID: wfID, WorkspaceID: project.WorkspaceID}); err != nil {
+			writeError(w, http.StatusBadRequest, "workflow not found")
+			return
+		}
+		key := rule.PropertyID + "/" + rule.OptionID
+		if seen[key] {
+			writeError(w, http.StatusBadRequest, "duplicate rule for the same option")
+			return
+		}
+		seen[key] = true
+		rules = append(rules, parsed{propID, wfID, rule.OptionID})
+	}
+	if err := h.Queries.DeleteProjectWorkflowRules(ctx, db.DeleteProjectWorkflowRulesParams{ProjectID: project.ID, WorkspaceID: project.WorkspaceID}); err != nil {
+		writeError(w, http.StatusInternalServerError, "failed to set rules")
+		return
+	}
+	for i, rule := range rules {
+		if err := h.Queries.CreateProjectWorkflowRule(ctx, db.CreateProjectWorkflowRuleParams{
+			ProjectID: project.ID, WorkspaceID: project.WorkspaceID, PropertyID: rule.property,
+			OptionID: rule.option, WorkflowID: rule.workflow, Position: int32(i),
+		}); err != nil {
+			writeError(w, http.StatusInternalServerError, "failed to set rules")
+			return
+		}
+	}
+	saved, _ := h.Queries.ListProjectWorkflowRules(ctx, db.ListProjectWorkflowRulesParams{ProjectID: project.ID, WorkspaceID: project.WorkspaceID})
+	writeJSON(w, http.StatusOK, map[string]any{"rules": rulesToJSON(saved)})
+}
+
+// ruleUsesProperty reports whether the issue's project picks workflows by this property.
+func (h *Handler) ruleUsesProperty(ctx context.Context, issue db.Issue, propertyID pgtype.UUID) bool {
+	if !issue.ProjectID.Valid {
+		return false
+	}
+	rules, err := h.Queries.ListProjectWorkflowRules(ctx, db.ListProjectWorkflowRulesParams{ProjectID: issue.ProjectID, WorkspaceID: issue.WorkspaceID})
+	if err != nil {
+		return false
+	}
+	for _, rule := range rules {
+		if rule.PropertyID == propertyID {
+			return true
+		}
+	}
+	return false
+}
+
+// refuseAgentRuleChange stops an agent from switching an issue's workflow
+// (by changing the property a rule reads) while the issue waits on a person.
+func (h *Handler) refuseAgentRuleChange(ctx context.Context, issue db.Issue, propertyID pgtype.UUID, callerType string) error {
+	if callerType != "agent" || !h.ruleUsesProperty(ctx, issue, propertyID) {
+		return nil
+	}
+	def, project, err := issueworkflow.ForIssue(ctx, h.Queries, issue.WorkspaceID, issue.ProjectID, issue.Properties)
+	if err != nil {
+		return err
+	}
+	if issueworkflow.PersonGate(def, issue.Status, project, issue.CreatorType, issue.CreatorID) {
+		return &issueworkflow.GateError{Status: issue.Status}
+	}
+	return nil
+}
+
+// followRuleWorkflow keeps an issue inside the workflow its new property value
+// picks: a status the new workflow does not list moves to the equivalent one,
+// as a project move does. No handoff runs; the next status change hands off.
+func (h *Handler) followRuleWorkflow(r *http.Request, prev, updated db.Issue, actorType, actorID string) {
+	ctx := r.Context()
+	if !h.ruleUsesAny(ctx, updated) {
+		return
+	}
+	def, _, err := issueworkflow.ForIssue(ctx, h.Queries, updated.WorkspaceID, updated.ProjectID, updated.Properties)
+	if err != nil || def == nil || def.IsDefault || def.Has(updated.Status) {
+		return
+	}
+	target := issueworkflow.MoveTarget(*def, updated.Status, func(key string) string {
+		return issuestatus.Category(ctx, h.Queries, updated.WorkspaceID, key)
+	})
+	moved, err := h.Queries.UpdateIssueStatus(ctx, db.UpdateIssueStatusParams{ID: updated.ID, Status: target, WorkspaceID: updated.WorkspaceID})
+	if err != nil {
+		slog.Warn("workflow rule: remap status failed", "issue_id", uuidToString(updated.ID), "error", err)
+		return
+	}
+	prefix := h.getIssuePrefix(ctx, moved.WorkspaceID)
+	resp := issueToResponse(moved, prefix)
+	h.fillStatusCategory(ctx, moved.WorkspaceID, &resp)
+	h.publish(protocol.EventIssueUpdated, uuidToString(moved.WorkspaceID), actorType, actorID, map[string]any{
+		"issue":          resp,
+		"status_changed": true,
+		"prev_status":    prev.Status,
+		"creator_type":   prev.CreatorType,
+		"creator_id":     uuidToString(prev.CreatorID),
+	})
+}
+
+func (h *Handler) ruleUsesAny(ctx context.Context, issue db.Issue) bool {
+	if !issue.ProjectID.Valid {
+		return false
+	}
+	rules, err := h.Queries.ListProjectWorkflowRules(ctx, db.ListProjectWorkflowRulesParams{ProjectID: issue.ProjectID, WorkspaceID: issue.WorkspaceID})
+	return err == nil && len(rules) > 0
+}
