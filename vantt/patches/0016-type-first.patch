               (p) =>
                 issue.properties?.[p.id] !== undefined ||
-                (!p.archived && visibleCustomProps.has(p.id)),
+                (!p.archived && (visibleCustomProps.has(p.id) || pinnedProperties.has(p.id))),
             )
             .map((p) => (
               <PropRow
