From 2edc84ee621bf27c0ac9b32246b0eeefaa58af3d Mon Sep 17 00:00:00 2001
From: Van Tran <trantoanvan@outlook.com>
Date: Tue, 10 Nov 2026 20:40:34 +0700
Subject: [PATCH] feat(issues): the property a project's workflow depends on is
 always shown

In a project whose workflow rules read a property (Type), the create-issue form
and the issue page show that property without "Add property", so the work type
is picked first, as Jira puts the work type first. Core: ruleProperties.

Patch-Id: type-first
---
 packages/core/workflow-rules/index.test.ts        | 9 +++++++++
 packages/core/workflow-rules/index.ts             | 9 +++++++++
 packages/views/issues/components/issue-detail.tsx | 6 +++++-
 packages/views/modals/create-issue.tsx            | 7 ++++++-
 4 files changed, 29 insertions(+), 2 deletions(-)

diff --git a/packages/core/workflow-rules/index.test.ts b/packages/core/workflow-rules/index.test.ts
index 6cdf4b335..532ee4d50 100644
--- a/packages/core/workflow-rules/index.test.ts
+++ b/packages/core/workflow-rules/index.test.ts
@@ -17,3 +17,12 @@ describe("mergeRuleWorkflows", () => {
     expect(mergeRuleWorkflows(delivery, [], [delivery], ["done"])).toBe(delivery);
   });
 });
+
+describe("ruleProperties", () => {
+  it("names the properties the rules read, once", async () => {
+    const { ruleProperties } = await import("./index");
+    const r = (p: string) => ({ property_id: p, option_id: "o", workflow_id: "w" });
+    expect([...ruleProperties([r("type"), r("type"), r("domain")])]).toEqual(["type", "domain"]);
+    expect(ruleProperties(undefined).size).toBe(0);
+  });
+});
diff --git a/packages/core/workflow-rules/index.ts b/packages/core/workflow-rules/index.ts
index 1dfc2949d..aea7d03a0 100644
--- a/packages/core/workflow-rules/index.ts
+++ b/packages/core/workflow-rules/index.ts
@@ -58,6 +58,15 @@ export function mergeRuleWorkflows<W extends { steps: { status_key: string }[] }
   return { ...project, steps };
 }
 
+/**
+ * The properties a project's rules read (e.g. Type): the issue's workflow depends
+ * on them, so the create form and the issue page show them without "Add property"
+ * (vantt workflow-by-type; Jira puts the work type first).
+ */
+export function ruleProperties(rules: readonly WorkflowRule[] | undefined): Set<string> {
+  return new Set((rules ?? []).map((r) => r.property_id));
+}
+
 export function useSetWorkflowRules(projectId: string) {
   const qc = useQueryClient();
   const wsId = useWorkspaceId();
