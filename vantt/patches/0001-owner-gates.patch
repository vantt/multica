 .../internal/handler/issue_workflow_entry.go  |  31 +++++
 .../handler/vantt_owner_gates_test.go         | 113 ++++++++++++++++++
 .../internal/issueworkflow/issueworkflow.go   |  25 ++++
 4 files changed, 180 insertions(+)
 create mode 100644 server/internal/handler/vantt_owner_gates_test.go

