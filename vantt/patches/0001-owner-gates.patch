diff --git a/server/internal/handler/issue_workflow_entry.go b/server/internal/handler/issue_workflow_entry.go
index 9c199cfbb..342747059 100644
--- a/server/internal/handler/issue_workflow_entry.go
+++ b/server/internal/handler/issue_workflow_entry.go
@@ -130,6 +130,15 @@ func writeIssueWorkflowError(w http.ResponseWriter, err error) bool {
 		})
