diff --git a/packages/views/issues/components/parent-issue-chip.test.tsx b/packages/views/issues/components/parent-issue-chip.test.tsx
new file mode 100644
index 000000000..12db8b674
--- /dev/null
+++ b/packages/views/issues/components/parent-issue-chip.test.tsx
@@ -0,0 +1,26 @@
+import { cleanup, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { renderWithI18n } from "../../test/i18n";
+import { ParentIssueChip } from "./parent-issue-chip";
+
+vi.mock("@multica/core/hooks", () => ({ useWorkspaceId: () => "ws-1" }));
+vi.mock("@multica/core/issues/queries", () => ({ issueDetailOptions: (_ws: string, id: string) => ({ queryKey: ["issue", id] }) }));
+vi.mock("@tanstack/react-query", () => ({
+  useQuery: (o: { queryKey: unknown[]; enabled?: boolean }) =>
+    o.enabled === false ? { data: undefined } : { data: { id: "p-1", identifier: "MOM-30", title: "E8 Landing v3" } },
+}));
+
+afterEach(cleanup);
+
+describe("ParentIssueChip", () => {
+  it("names the parent of a sub-issue", () => {
+    renderWithI18n(<ParentIssueChip parentId="p-1" />);
+    expect(screen.getByText("MOM-30")).toBeTruthy();
+    expect(screen.getByTitle("Sub-issue of MOM-30 · E8 Landing v3")).toBeTruthy();
+  });
+
+  it("shows nothing for a top-level issue", () => {
+    renderWithI18n(<ParentIssueChip parentId={null} />);
+    expect(screen.queryByText("MOM-30")).toBeNull();
+  });
+});
diff --git a/packages/views/issues/components/parent-issue-chip.tsx b/packages/views/issues/components/parent-issue-chip.tsx
new file mode 100644
index 000000000..e27ec11d9
--- /dev/null
+++ b/packages/views/issues/components/parent-issue-chip.tsx
@@ -0,0 +1,34 @@
+"use client";
+
+import { useQuery } from "@tanstack/react-query";
+import { CornerDownRight } from "lucide-react";
+import { useWorkspaceId } from "@multica/core/hooks";
+import { issueDetailOptions } from "@multica/core/issues/queries";
+import { cn } from "@multica/ui/lib/utils";
+import { useT } from "../../i18n";
+
+/**
+ * Which parent a sub-issue belongs to (vantt parent-child, design D9), shown on
+ * board cards and list rows next to the identifier. Reference: Jira's epic
+ * link on cards; Linear's parent label on sub-issues. Parents already show their
+ * sub-issue progress ring.
+ */
+export function ParentIssueChip({ parentId, className }: { parentId: string | null | undefined; className?: string }) {
+  const { t } = useT("issues");
+  const wsId = useWorkspaceId();
+  const { data: parent } = useQuery({ ...issueDetailOptions(wsId, parentId ?? ""), enabled: Boolean(parentId) });
+  if (!parentId || !parent) return null;
+  return (
+    <span
+      title={t(($) => $.parent_chip.title, { identifier: parent.identifier, title: parent.title })}
+      className={cn(
+        "inline-flex min-w-0 max-w-[180px] shrink items-center gap-1 rounded-full bg-muted/60 px-1.5 py-0.5 text-micro text-muted-foreground",
+        className,
+      )}
+    >
+      <CornerDownRight aria-hidden className="size-3 shrink-0" />
+      <span className="shrink-0">{parent.identifier}</span>
+      <span className="truncate">{parent.title}</span>
+    </span>
+  );
+}
