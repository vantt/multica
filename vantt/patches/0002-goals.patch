+		map[string]any{"ids": []string{detail.History[1].ID}}), "id", g.ID))).Want(http.StatusNoContent)
+}
+
+// A goal a person creates in Multica lives in a repo once it is linked to exactly
+// one project: the PM may then adopt it (write source_ref). Company goals, or goals
+// of several projects, stay with people.
+func TestGoalRepoHomeByProjectLink(t *testing.T) {
+	seedTestCatalog(t)
+	agentID := seededReadyAgentID(t)
+	issueID := dbfx.Issue(t, "pm adopt", testutil.Cols{"status": "todo"})
+	taskID := runningTask(t, agentID, issueID, "todo")
+	asAgent := func(req *http.Request) *http.Request {
+		req.Header.Set("X-Actor-Source", "task_token")
+		req.Header.Set("X-Agent-ID", agentID)
+		req.Header.Set("X-Task-ID", taskID)
+		return req
+	}
+	p1 := dbfx.Project(t, "goal home one")
+	p2 := dbfx.Project(t, "goal home two")
+	p3 := dbfx.Project(t, "goal home three, same repo as one")
+	repo := func(project, url string) {
+		dbfx.Exec(t, `INSERT INTO project_resource (project_id, workspace_id, resource_type, resource_ref, label, position)
+			VALUES ($1, $2, 'github_repo', jsonb_build_object('url', $3::text), 'repo', 0)`, project, testWorkspaceID, url)
+	}
+	repo(p1, "https://github.com/vantt/app")
+	repo(p2, "https://github.com/vantt/other")
+	repo(p3, "https://github.com/vantt/app.git")
+	g := createGoalForTest(t, map[string]any{"title": "Company goal", "target_value": 1000})
+	adopt := func() *testutil.Response {
+		return testutil.Call(t, testHandler.UpdateGoal, asAgent(withURLParam(goalRequest("PATCH", "/api/goals/"+g.ID,
+			map[string]any{"source_ref": "vantt/app:plans/goals.md#G2", "pending": false}), "id", g.ID)))
+	}
+	link := func(ids ...string) {
+		links := []map[string]any{}
+		for _, id := range ids {
+			links = append(links, map[string]any{"target_type": "project", "target_id": id})
+		}
+		testutil.Call(t, testHandler.SetGoalLinks, withURLParam(goalRequest("PUT", "/api/goals/"+g.ID+"/links", map[string]any{"links": links}), "id", g.ID)).Want(http.StatusOK)
+	}
+	adopt().Want(http.StatusForbidden) // no project: company goal
+	link(p1, p2)
+	adopt().Want(http.StatusForbidden) // two repos
+	link(p1, p3)
+	adopt().Want(http.StatusOK) // two projects, one repo
+}
+
+func TestGoalWithoutRepoStaysWithPeople(t *testing.T) {
+	seedTestCatalog(t)
+	agentID := seededReadyAgentID(t)
+	issueID := dbfx.Issue(t, "pm no repo", testutil.Cols{"status": "todo"})
+	taskID := runningTask(t, agentID, issueID, "todo")
+	p := dbfx.Project(t, "no repo project")
+	g := createGoalForTest(t, map[string]any{"title": "No repo", "target_value": 3})
+	testutil.Call(t, testHandler.SetGoalLinks, withURLParam(goalRequest("PUT", "/api/goals/"+g.ID+"/links",
+		map[string]any{"links": []map[string]any{{"target_type": "project", "target_id": p}}}), "id", g.ID)).Want(http.StatusOK)
+	req := withURLParam(goalRequest("PATCH", "/api/goals/"+g.ID, map[string]any{"source_ref": "x:plans/goals.md#G1"}), "id", g.ID)
+	req.Header.Set("X-Actor-Source", "task_token")
+	req.Header.Set("X-Agent-ID", agentID)
+	req.Header.Set("X-Task-ID", taskID)
+	testutil.Call(t, testHandler.UpdateGoal, req).Want(http.StatusForbidden)
+}
+
+// The owner running the repo sync by hand mirrors exactly like the PM.
+func TestGoalMirrorByOwner(t *testing.T) {
+	g := createGoalForTest(t, map[string]any{"title": "Mirror", "target_value": 10, "source_ref": "plans/goals.md#G9", "pending": false})
+	if g.Pending {
+		t.Fatal("a mirror sent pending=false")
+	}
+	req := withURLParam(goalRequest("POST", "/api/goals/"+g.ID+"/values", map[string]any{"value": 3, "recorded_at": "2026-11-01"}), "id", g.ID)
+	testutil.Call(t, testHandler.AddGoalValue, req).Want(http.StatusOK)
+	var detail struct {
+		History []GoalValueResponse `json:"history"`
+	}
+	testutil.Call(t, testHandler.GetGoal, withURLParam(goalRequest("GET", "/api/goals/"+g.ID, nil), "id", g.ID)).Want(http.StatusOK).JSON(&detail)
+	if len(detail.History) != 1 || !detail.History[0].Synced || detail.History[0].CreatedAt[:10] != "2026-11-01" {
+		t.Fatalf("history = %+v", detail.History)
+	}
+}
