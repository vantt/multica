@@ -0,0 +1,32 @@
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { api } from "../api";
+import { useWorkspaceId } from "../hooks";
+import { goalKeys } from "./queries";
+import type { GoalWriteRequest } from "./types";
+
+function useInvalidateGoals() {
+  const qc = useQueryClient();
+  const wsId = useWorkspaceId();
+  return () => qc.invalidateQueries({ queryKey: goalKeys.all(wsId) });
+}
+
+export function useCreateGoal() {
+  const invalidate = useInvalidateGoals();
+  return useMutation({ mutationFn: (body: GoalWriteRequest) => api.createGoal(body), onSuccess: invalidate });
+}
+
+export function useUpdateGoal() {
+  const invalidate = useInvalidateGoals();
+  return useMutation({
+    mutationFn: ({ id, ...body }: GoalWriteRequest & { id: string }) => api.updateGoal(id, body),
+    onSuccess: invalidate,
+  });
+}
+
+export function useAddGoalValue() {
+  const invalidate = useInvalidateGoals();
+  return useMutation({
+    mutationFn: ({ id, value, note }: { id: string; value: number; note?: string }) => api.addGoalValue(id, value, note ?? ""),
+    onSuccess: invalidate,
+  });
+}
diff --git a/packages/core/goals/queries.ts b/packages/core/goals/queries.ts
new file mode 100644
index 000000000..4c3a2a782
--- /dev/null
+++ b/packages/core/goals/queries.ts
@@ -0,0 +1,50 @@
+import { queryOptions } from "@tanstack/react-query";
+import { api } from "../api";
+import type { Goal } from "./types";
+
+export const goalKeys = {
+  all: (wsId: string) => ["goals", wsId] as const,
+  list: (wsId: string) => [...goalKeys.all(wsId), "list"] as const,
+  detail: (wsId: string, id: string) => [...goalKeys.all(wsId), "detail", id] as const,
+};
+
+export function goalListOptions(wsId: string) {
+  return queryOptions({
+    queryKey: goalKeys.list(wsId),
+    queryFn: () => api.listGoals(),
+    select: (data) => data.goals,
+    staleTime: 60_000,
+  });
+}
+
+export function goalDetailOptions(wsId: string, id: string) {
+  return queryOptions({
+    queryKey: goalKeys.detail(wsId, id),
+    queryFn: () => api.getGoal(id),
+  });
+}
+
+/** Goals as a tree: roots first, each followed by its children, in position order. */
+export function goalTree(goals: readonly Goal[]): { goal: Goal; depth: number }[] {
+  const byParent = new Map<string | null, Goal[]>();
+  const ids = new Set(goals.map((g) => g.id));
+  for (const g of goals) {
+    const key = g.parent_id && ids.has(g.parent_id) ? g.parent_id : null;
+    byParent.set(key, [...(byParent.get(key) ?? []), g]);
+  }
+  const out: { goal: Goal; depth: number }[] = [];
+  const walk = (parent: string | null, depth: number) => {
+    for (const g of byParent.get(parent) ?? []) {
+      out.push({ goal: g, depth });
+      walk(g.id, depth + 1);
+    }
+  };
+  walk(null, 0);
+  return out;
+}
+
+/** The goals that a project or an issue (or its parent) moves. */
+export function goalsForTarget(goals: readonly Goal[], targetType: "project" | "issue", ids: (string | null | undefined)[]): Goal[] {
+  const want = new Set(ids.filter(Boolean) as string[]);
+  return goals.filter((g) => g.links.some((l) => l.target_type === targetType && want.has(l.target_id)));
+}
diff --git a/packages/core/goals/schemas.test.ts b/packages/core/goals/schemas.test.ts
new file mode 100644
index 000000000..335bfbe74
--- /dev/null
+++ b/packages/core/goals/schemas.test.ts
@@ -0,0 +1,40 @@
+// @vitest-environment node
+import { describe, expect, it } from "vitest";
+import { parseWithFallback } from "../api/schema";
+import { EMPTY_GOALS, GoalDetailSchema, ListGoalsSchema } from "./schemas";
+import { goalTree, goalsForTarget } from "./queries";
+import type { Goal } from "./types";
+
+const goal = (over: Partial<Goal> = {}) =>
+  ListGoalsSchema.parse({ goals: [{ id: "g1", title: "Paying customers", target_value: 50, ...over }] }).goals[0]!;
+
+describe("goal schemas", () => {
+  it("fills defaults and tolerates unknown enums", () => {
+    const g = goal({ health: "sideways" as never, links: "bad" as never });
+    expect(g.health).toBe("no_target_date");
+    expect(g.links).toEqual([]);
+    expect(g.current_value).toBe(0);
+  });
+
+  it("falls back on a malformed list", () => {
+    expect(parseWithFallback("nope", ListGoalsSchema, EMPTY_GOALS, { endpoint: "test" })).toEqual(EMPTY_GOALS);
+  });
+
+  it("parses a detail with history", () => {
+    const d = GoalDetailSchema.parse({ goal: { id: "g1", title: "x", target_value: 1 }, history: [{ id: "v1", value: 3 }] });
+    expect(d.history[0]?.value).toBe(3);
+  });
+});
+
+describe("goal helpers", () => {
+  it("orders the tree parents first", () => {
+    const tree = goalTree([goal({ id: "c", parent_id: "p" }), goal({ id: "p" })]);
+    expect(tree.map((t) => [t.goal.id, t.depth])).toEqual([["p", 0], ["c", 1]]);
+  });
+
+  it("finds goals for an issue or its parent", () => {
+    const g = goal({ links: [{ target_type: "issue", target_id: "epic-1" }] });
+    expect(goalsForTarget([g], "issue", ["child-1", "epic-1"])).toHaveLength(1);
+    expect(goalsForTarget([g], "issue", ["other"])).toHaveLength(0);
+  });
+});
diff --git a/packages/core/goals/schemas.ts b/packages/core/goals/schemas.ts
new file mode 100644
index 000000000..f04962dde
--- /dev/null
+++ b/packages/core/goals/schemas.ts
@@ -0,0 +1,63 @@
+import { z } from "zod";
+import type { Goal, GoalDetail } from "./types";
+
+const HEALTHS = ["on_track", "at_risk", "off_track", "no_target_date", "planned", "achieved", "missed", "cancelled"] as const;
+const STATUSES = ["planned", "active", "achieved", "missed", "cancelled"] as const;
+
+const num = z.number().catch(0);
+const optNum = z.number().nullable().catch(null);
+const str = z.string().catch("");
+const optStr = z.string().nullable().catch(null);
+
+export const GoalSchema = z.object({
+  id: z.string(),
+  workspace_id: str,
+  parent_id: optStr,
+  title: str,
+  description: str,
+  unit: str,
+  direction: z.enum(["increase", "decrease"]).catch("increase"),
+  start_value: num,
+  target_value: num,
+  current_value: num,
+  due_date: optStr,
+  status: z.enum(STATUSES).catch("active"),
+  measured_by: z.enum(["manual", "script"]).catch("manual"),
+  owner_type: optStr,
+  owner_id: optStr,
+  position: num,
+  current_updated_at: str,
+  created_at: str,
+  updated_at: str,
+  links: z
+    .array(z.object({ target_type: z.enum(["project", "issue"]), target_id: z.string() }))
+    .catch([]),
+  progress: num,
+  expected: optNum,
+  // Unknown health values from a newer server read as on-track-neutral.
+  health: z.enum(HEALTHS).catch("no_target_date"),
+  update_due: z.boolean().catch(false),
+  needed_per_week: optNum,
+  actual_per_week: optNum,
+});
+
+export const ListGoalsSchema = z.object({ goals: z.array(GoalSchema).catch([]) });
+
+export const GoalDetailSchema = z.object({
+  goal: GoalSchema,
+  history: z
+    .array(
+      z.object({
+        id: z.string(),
+        value: num,
+        note: str,
+        actor_type: str,
+        actor_id: optStr,
+        created_at: str,
+      }),
+    )
+    .catch([]),
+});
+
+export const EMPTY_GOALS: { goals: Goal[] } = { goals: [] };
+export const EMPTY_GOAL_DETAIL: GoalDetail | null = null;
